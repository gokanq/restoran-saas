generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  COURIER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ON_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  TABLE
  DELIVERY
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  ONLINE
  MEAL_CARD
  OPEN_ACCOUNT
}

enum TableSessionStatus {
  OPEN
  PAYMENT_PENDING
  CLOSED
  CANCELLED
}

enum TableSessionItemStatus {
  NEW
  SENT
  PREPARING
  SERVED
  VOID
}

model Restaurant {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  isActive                Boolean                  @default(true)
  users                   User[]
  branches                Branch[]
  orders                  Order[]
  couriers                Courier[]
  courierWorkLogs         CourierWorkLog[]
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  customers               Customer[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  menuItemOptionGroups    MenuItemOptionGroup[]
  menuItemOptions         MenuItemOption[]
  diningAreas             DiningArea[]
  restaurantTables        RestaurantTable[]
  tableSessions           TableSession[]
  menuItemChannelSettings MenuItemChannelSetting[]
}

model Branch {
  id                      String                   @id @default(cuid())
  restaurantId            String
  name                    String
  address                 String?
  phone                   String?
  latitude                Decimal?                 @db.Decimal(10, 7)
  longitude               Decimal?                 @db.Decimal(10, 7)
  restaurant              Restaurant               @relation(fields: [restaurantId], references: [id])
  orders                  Order[]
  couriers                Courier[]
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  customers               Customer[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  menuItemOptionGroups    MenuItemOptionGroup[]
  menuItemOptions         MenuItemOption[]
  diningAreas             DiningArea[]
  restaurantTables        RestaurantTable[]
  tableSessions           TableSession[]
  menuItemChannelSettings MenuItemChannelSetting[]
}

model DiningArea {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  name         String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  branch     Branch            @relation(fields: [branchId], references: [id])
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([isActive])
  @@index([deletedAt])
}

model RestaurantTable {
  id            String    @id @default(cuid())
  restaurantId  String
  branchId      String
  diningAreaId  String?
  code          String
  name          String
  capacity      Int?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  isReserved    Boolean   @default(false)
  reservedName  String?
  reservedPhone String?
  reservedNote  String?
  reservedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id])
  branch     Branch         @relation(fields: [branchId], references: [id])
  diningArea DiningArea?    @relation(fields: [diningAreaId], references: [id])
  sessions   TableSession[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([diningAreaId])
  @@index([isActive])
  @@index([isReserved])
  @@index([deletedAt])
}

model TableSession {
  id              String             @id @default(cuid())
  restaurantId    String
  branchId        String
  tableId         String
  orderId         String?
  status          TableSessionStatus @default(OPEN)
  paymentMethod   PaymentMethod?
  openedByUserId  String?
  closedByUserId  String?
  cancelledReason String?
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id])
  branch     Branch             @relation(fields: [branchId], references: [id])
  table      RestaurantTable    @relation(fields: [tableId], references: [id])
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items      TableSessionItem[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@index([orderId])
  @@index([status])
}

model TableSessionItem {
  id         String                 @id @default(cuid())
  sessionId  String
  menuItemId String?
  name       String
  quantity   Int                    @default(1)
  unitPrice  Decimal                @default(0) @db.Decimal(10, 2)
  totalPrice Decimal                @default(0) @db.Decimal(10, 2)
  note       String?
  status     TableSessionItemStatus @default(NEW)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  session  TableSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItem MenuItem?                @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  options  TableSessionItemOption[]

  @@index([sessionId])
  @@index([menuItemId])
  @@index([status])
}

model TableSessionItemOption {
  id         String   @id @default(cuid())
  itemId     String
  optionId   String?
  groupName  String
  optionName String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  item   TableSessionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  option MenuItemOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([optionId])
}

model User {
  id           String      @id @default(cuid())
  restaurantId String?
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(ADMIN)
  isActive     Boolean     @default(true)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model CallerDevice {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String?
  name         String
  keyHash      String    @unique
  keyPreview   String
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId])
  @@index([branchId])
  @@index([isActive])
}

model CallerEvent {
  id              String    @id @default(cuid())
  restaurantId    String
  branchId        String?
  phone           String
  phoneNormalized String?
  status          String    @default("NEW")
  source          String?
  customerId      String?
  customerName    String?
  orderId         String?
  orderCode       String?
  convertedAt     DateTime?
  payload         Json?
  receivedAt      DateTime  @default(now())
  seenAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, receivedAt])
  @@index([restaurantId, phoneNormalized])
  @@index([branchId])
  @@index([customerId])
  @@index([orderId])
  @@index([restaurantId, convertedAt])
}

model Customer {
  id              String            @id @default(cuid())
  restaurantId    String
  branchId        String?
  name            String
  phone           String?
  phoneNormalized String?
  email           String?
  notes           String?
  isActive        Boolean           @default(true)
  deletedAt       DateTime?
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  branch          Branch?           @relation(fields: [branchId], references: [id])
  addresses       CustomerAddress[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([restaurantId])
  @@index([branchId])
  @@index([phoneNormalized])
  @@index([deletedAt])
}

model CustomerAddress {
  id           String    @id @default(cuid())
  customerId   String
  title        String?
  type         String    @default("Ev")
  district     String?
  neighborhood String?
  street       String?
  buildingNo   String?
  floorNo      String?
  doorNo       String?
  description  String?
  fullAddress  String?
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  customer     Customer  @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([customerId])
  @@index([deletedAt])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  branchId     String?
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  branch       Branch?    @relation(fields: [branchId], references: [id])
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id                      String                   @id @default(cuid())
  restaurantId            String
  branchId                String?
  categoryId              String?
  name                    String
  description             String?
  imageUrl                String?
  price                   Decimal                  @default(0) @db.Decimal(10, 2)
  isActive                Boolean                  @default(true)
  deletedAt               DateTime?
  restaurant              Restaurant               @relation(fields: [restaurantId], references: [id])
  branch                  Branch?                  @relation(fields: [branchId], references: [id])
  category                MenuCategory?            @relation(fields: [categoryId], references: [id])
  orderItems              OrderItem[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  optionGroups            MenuItemOptionGroup[]
  tableSessionItems       TableSessionItem[]
  menuItemChannelSettings MenuItemChannelSetting[]
}

model Courier {
  id             String               @id @default(cuid())
  restaurantId   String
  branchId       String?
  name           String
  phone          String?
  perPackageFee  Decimal              @default(0) @db.Decimal(10, 2)
  hourlyFee      Decimal              @default(0) @db.Decimal(10, 2)
  isActive       Boolean              @default(true)
  latitude       Decimal?             @db.Decimal(10, 7)
  longitude      Decimal?             @db.Decimal(10, 7)
  isOnline       Boolean              @default(false)
  isAvailable    Boolean              @default(true)
  lastLocationAt DateTime?
  pinCode        String?
  authToken      String?              @unique
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id])
  branch         Branch?              @relation(fields: [branchId], references: [id])
  orders         Order[]
  workLogs       CourierWorkLog[]
  assignments    DeliveryAssignment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([restaurantId])
  @@index([branchId])
  @@index([isActive])
}

model CourierWorkLog {
  id           String     @id @default(cuid())
  restaurantId String
  courierId    String
  workDate     DateTime   @db.Date
  hours        Decimal    @default(0) @db.Decimal(10, 2)
  note         String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  courier      Courier    @relation(fields: [courierId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, courierId, workDate])
  @@index([restaurantId, workDate])
  @@index([courierId])
}

model Order {
  id              String              @id @default(cuid())
  restaurantId    String
  branchId        String
  code            String
  type            OrderType           @default(DELIVERY)
  tableNumber     String?
  status          OrderStatus         @default(PENDING)
  total           Decimal             @default(0) @db.Decimal(10, 2)
  paymentMethod   PaymentMethod       @default(CASH)
  customerName    String?
  customerPhone   String?
  customerAddress String?
  deliveryLat     Decimal?            @db.Decimal(10, 7)
  deliveryLng     Decimal?            @db.Decimal(10, 7)
  courierId       String?
  courierName     String?
  note            String?
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  courier         Courier?            @relation(fields: [courierId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  tableSessions   TableSession[]
  callerEvents    CallerEvent[]
  assignment      DeliveryAssignment?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([courierId])
  @@index([status])
}

model OrderItem {
  id         String            @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  quantity   Int               @default(1)
  unitPrice  Decimal           @default(0) @db.Decimal(10, 2)
  totalPrice Decimal           @default(0) @db.Decimal(10, 2)
  note       String?
  order      Order             @relation(fields: [orderId], references: [id])
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  options    OrderItemOption[]
}

model MenuItemChannelSetting {
  id           String      @id @default(cuid())
  restaurantId String
  branchId     String?
  menuItemId   String
  channel      MenuChannel
  isEnabled    Boolean     @default(true)
  customPrice  Decimal?    @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, channel])
  @@index([restaurantId])
  @@index([branchId])
  @@index([channel])
}

model MenuItemOptionGroup {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String?
  menuItemId   String
  name         String
  isRequired   Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  branch     Branch?          @relation(fields: [branchId], references: [id])
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options    MenuItemOption[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([menuItemId])
}

model MenuItemOption {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String?
  groupId      String
  name         String
  priceDelta   Decimal  @default(0)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant              Restaurant               @relation(fields: [restaurantId], references: [id])
  branch                  Branch?                  @relation(fields: [branchId], references: [id])
  group                   MenuItemOptionGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemOptions        OrderItemOption[]
  tableSessionItemOptions TableSessionItemOption[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([groupId])
}

model OrderItemOption {
  id          String   @id @default(cuid())
  orderItemId String
  optionId    String?
  groupName   String
  optionName  String
  priceDelta  Decimal  @default(0)
  createdAt   DateTime @default(now())

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    MenuItemOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
}

enum DeliveryAssignmentStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERING
  DELIVERED
  CANCELLED
  REJECTED
}

enum MenuChannel {
  QR
  TABLE_SERVICE
  CALLER_ID
  MOBILE
  WHATSAPP
}

enum PlatformType {
  TRENDYOL
  GETIR
  YEMEKSEPETI
}

model PlatformIntegration {
  id           String       @id @default(cuid())
  restaurantId String
  branchId     String?
  platform     PlatformType
  name         String       @default("")
  isActive     Boolean      @default(true)
  supplierId   String?
  apiKey       String?
  apiSecret    String?
  baseUrl      String?
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([restaurantId])
  @@index([platform])
  @@index([isActive])
}

model PlatformOrder {
  id              String       @id @default(cuid())
  restaurantId    String
  platform        PlatformType
  platformOrderId String
  platformStatus  String?
  orderId         String?      @unique
  rawPayload      Json?
  syncedAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([platform, platformOrderId])
  @@index([restaurantId])
  @@index([platform, restaurantId])
}

model RestaurantSettings {
  id                 String   @id @default(cuid())
  restaurantId       String   @unique
  isOpen             Boolean  @default(true)
  autoApproveOrders  Boolean  @default(false)
  notificationSound  String   @default("bell")
  notificationVolume Int      @default(80)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([restaurantId])
}

model LocationDistrict {
  id            String                 @id @default(cuid())
  city          String
  name          String
  sortOrder     Int                    @default(0)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  neighborhoods LocationNeighborhood[]

  @@unique([city, name])
  @@index([city, isActive])
}

model LocationNeighborhood {
  id         String           @id @default(cuid())
  districtId String
  name       String
  sortOrder  Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  district   LocationDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, name])
  @@index([districtId, isActive])
}

model DeliveryAssignment {
  id              String                   @id @default(cuid())
  restaurantId    String
  branchId        String?
  orderId         String                   @unique
  courierId       String
  status          DeliveryAssignmentStatus @default(PENDING)
  distance        Decimal?                 @db.Decimal(10, 2)
  duration        Int?
  routeGeometry   String?
  pickupLat       Decimal?                 @db.Decimal(10, 7)
  pickupLng       Decimal?                 @db.Decimal(10, 7)
  dropoffLat      Decimal?                 @db.Decimal(10, 7)
  dropoffLng      Decimal?                 @db.Decimal(10, 7)
  earnings        Decimal?                 @db.Decimal(10, 2)
  proofPhotoUrl   String?
  rejectionReason String?
  assignedAt      DateTime                 @default(now())
  acceptedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier @relation(fields: [courierId], references: [id])

  @@index([restaurantId])
  @@index([courierId])
  @@index([status])
  @@index([assignedAt])
}
